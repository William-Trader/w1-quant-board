<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="William 量化看板 W1 — William 运算核心：每日判断、姿态评分、8币立场、情绪、资金流、多空LSR、费率套利、KOL共识、AI日报、翻转倒计时，审批制会员系统。">
<title>William 量化看板 W1</title>
<style>
/* ============ William 量化看板 W1 · 深色量化终端（低饱和） ============ */
:root{
  --bg0:#14161a; --bg1:#1b1e24; --bg2:#22262d; --bg3:#2a2f38;
  --line:#31363f; --line2:#3c424d;
  --amber:#d9a441; --amber-dim:#8a6c30; --amber-soft:rgba(217,164,65,.12);
  --text:#d8d5cd; --text2:#9d998f; --text3:#6d6a62;
  --green:#5f9e7a; --green-soft:rgba(95,158,122,.14);
  --red:#c06a5e; --red-soft:rgba(192,106,94,.14);
  --yellow:#c9a24d;
  --serif:"Iowan Old Style","Palatino Linotype","Book Antiqua",Georgia,"Songti SC","SimSun",serif;
  --mono:"SF Mono",Menlo,Consolas,"Liberation Mono",monospace;
  --sans:-apple-system,"Helvetica Neue","PingFang SC","Microsoft YaHei",sans-serif;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{background:var(--bg0);color:var(--text);font-family:var(--sans);font-size:14px;line-height:1.6;min-height:100vh}
a{color:var(--amber);text-decoration:none}
a:hover{text-decoration:underline}
::selection{background:var(--amber-dim);color:#fff}
::-webkit-scrollbar{width:8px;height:8px}
::-webkit-scrollbar-track{background:var(--bg0)}
::-webkit-scrollbar-thumb{background:var(--line2);border-radius:4px}

/* ---- 顶栏 ---- */
.topbar{border-bottom:1px solid var(--line);background:linear-gradient(180deg,#191c21,#14161a);position:sticky;top:0;z-index:50}
.topbar-inner{max-width:1280px;margin:0 auto;padding:14px 20px 10px}
.brand-row{display:flex;align-items:baseline;gap:14px;flex-wrap:wrap}
.brand{font-family:var(--serif);font-size:22px;letter-spacing:.5px;color:var(--text)}
.brand em{font-style:normal;color:var(--amber)}
.brand-sub{font-family:var(--mono);font-size:11px;color:var(--text3);letter-spacing:1px;text-transform:uppercase}
.top-actions{margin-left:auto;display:flex;gap:8px;align-items:center}
.clock{font-family:var(--mono);font-size:12px;color:var(--text2)}
.lang-btn,.ghost-btn{background:var(--bg2);border:1px solid var(--line2);color:var(--text2);font-size:12px;padding:5px 12px;border-radius:4px;cursor:pointer;font-family:var(--sans);transition:.15s}.oi-g{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:8px 0}.oi-i{background:var(--bg2);border-radius:6px;padding:8px 10px}.oi-l{font-size:11px;color:var(--text3);margin-bottom:2px}.oi-v{font-size:15px;font-weight:600;font-family:var(--mono)}.oi-bar-wrap{display:flex;align-items:center;gap:10px;margin:6px 0}.oi-bar{flex:1;height:16px;border-radius:8px;background:#1a1c21;overflow:hidden}.oi-bar-f{height:100%;border-radius:8px;transition:width .5s}.oi-bar-l{font-size:13px;font-family:var(--mono);min-width:58px;text-align:right}
.lang-btn:hover,.ghost-btn:hover{border-color:var(--amber-dim);color:var(--amber)}
.user-chip{font-family:var(--mono);font-size:12px;color:var(--green);border:1px solid rgba(95,158,122,.35);padding:4px 10px;border-radius:4px;background:var(--green-soft)}

/* ---- Tab 导航 ---- */
.tabnav{max-width:1280px;margin:0 auto;padding:0 20px;display:flex;gap:2px;overflow-x:auto;scrollbar-width:none}
.tabnav::-webkit-scrollbar{display:none}
.tab{padding:9px 14px;font-size:13px;color:var(--text2);cursor:pointer;border-bottom:2px solid transparent;white-space:nowrap;transition:.15s;user-select:none}
.tab:hover{color:var(--text)}
.tab.active{color:var(--amber);border-bottom-color:var(--amber);font-weight:600}
.tab .lock{font-size:10px;color:var(--text3);margin-left:3px}
.tab.member-tab.active .lock{color:var(--amber-dim)}

/* ---- 主体 ---- */
main{max-width:1280px;margin:0 auto;padding:20px}
.panel{display:none;animation:fadein .25s ease}
.panel.active{display:block}
@keyframes fadein{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}

/* ---- 卡片 ---- */
.card{background:var(--bg1);border:1px solid var(--line);border-radius:8px;padding:18px 20px;margin-bottom:16px}
.card-title{font-family:var(--serif);font-size:16px;color:var(--text);margin-bottom:12px;display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.card-title::before{content:"";width:3px;height:16px;background:var(--amber);border-radius:2px;flex:none}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.grid4{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
@media(max-width:960px){.grid2,.grid3,.grid4{grid-template-columns:1fr}}

/* ---- 徽章 / 状态 ---- */
.badge{display:inline-block;font-family:var(--mono);font-size:11px;padding:2px 9px;border-radius:3px;letter-spacing:.5px;border:1px solid}
.badge.bullish,.badge.risk_on,.badge.aggressive,.badge.approved{color:var(--green);border-color:rgba(95,158,122,.4);background:var(--green-soft)}
.badge.cautiously_bullish{color:#8aa37a;border-color:rgba(138,163,122,.35);background:rgba(138,163,122,.1)}
.badge.neutral,.badge.cautious,.badge.pending{color:var(--amber);border-color:rgba(217,164,65,.35);background:var(--amber-soft)}
.badge.cautiously_bearish{color:#b98a6b;border-color:rgba(185,138,107,.35);background:rgba(185,138,107,.1)}
.badge.bearish,.badge.risk_off,.badge.defensive,.badge.rejected{color:var(--red);border-color:rgba(192,106,94,.4);background:var(--red-soft)}
.badge.diverge{color:var(--yellow);border-color:rgba(201,162,77,.5);background:rgba(201,162,77,.12)}
.dot{display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:5px}
.dot.g{background:var(--green);box-shadow:0 0 6px rgba(95,158,122,.6)}
.dot.y{background:var(--yellow)}
.dot.r{background:var(--red)}
.dot.gray{background:var(--text3)}

/* ---- 每日判断卡 ---- */
.verdict-hero{display:grid;grid-template-columns:340px 1fr;gap:20px}
@media(max-width:960px){.verdict-hero{grid-template-columns:1fr}}
.verdict-main-text{font-family:var(--serif);font-size:17px;line-height:1.8;color:var(--text)}
.verdict-label{font-family:var(--mono);font-size:10px;color:var(--text3);letter-spacing:2px;text-transform:uppercase;margin:14px 0 4px}
.verdict-block{font-size:13px;color:var(--text2);line-height:1.75}
.verdict-block b{color:var(--text);font-weight:600}
.whatsnew{border-left:2px solid var(--amber-dim);padding-left:12px;margin-top:12px;font-size:13px;color:var(--text2)}
.diverge-box{margin-top:12px;padding:10px 14px;border:1px dashed rgba(201,162,77,.45);border-radius:6px;font-size:12.5px;color:var(--yellow);background:rgba(201,162,77,.06)}
.quote-box{font-family:var(--serif);font-style:italic;font-size:14.5px;line-height:1.8;color:var(--text2);border-left:3px solid var(--amber);padding:6px 0 6px 16px;margin:4px 0}
.quote-src{font-style:normal;font-family:var(--mono);font-size:10.5px;color:var(--text3);display:block;margin-top:6px}

/* ---- posture 仪表 ---- */
.gauge-wrap{display:flex;flex-direction:column;align-items:center;gap:6px}
.gauge-score{font-family:var(--mono);font-size:34px;color:var(--amber);line-height:1}
.gauge-state{font-family:var(--serif);font-size:15px}
.days-held{font-family:var(--mono);font-size:11px;color:var(--text3)}
.factor-row{display:grid;grid-template-columns:130px 1fr 46px;align-items:center;gap:10px;margin:7px 0;font-size:12px}
.factor-name{color:var(--text2)}
.factor-bar{position:relative;height:10px;background:var(--bg2);border-radius:5px;overflow:hidden}
.factor-center{position:absolute;left:50%;top:0;bottom:0;width:1px;background:var(--line2)}
.factor-fill{position:absolute;top:0;bottom:0;border-radius:5px}
.factor-fill.pos{background:var(--green);opacity:.75}
.factor-fill.neg{background:var(--red);opacity:.75}
.factor-val{font-family:var(--mono);font-size:11px;text-align:right;color:var(--text2)}

/* ---- 表格 ---- */
table{width:100%;border-collapse:collapse;font-size:12.5px}
th{font-family:var(--mono);font-size:10.5px;letter-spacing:1px;color:var(--text3);text-transform:uppercase;text-align:left;padding:8px 10px;border-bottom:1px solid var(--line2);white-space:nowrap}
td{padding:8px 10px;border-bottom:1px solid var(--line);color:var(--text2);vertical-align:middle}
tr:hover td{background:rgba(255,255,255,.02)}
.num{font-family:var(--mono);font-size:12.5px}
.up{color:var(--green)}.down{color:var(--red)}.flat{color:var(--text3)}
tr.pending-row td{background:rgba(217,164,65,.07)}
tr.pending-row td:first-child{border-left:2px solid var(--amber)}

/* ---- 8币卡 ---- */
.coin-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
@media(max-width:1100px){.coin-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:640px){.coin-grid{grid-template-columns:1fr}}
.coin-card{background:var(--bg1);border:1px solid var(--line);border-radius:8px;padding:15px 16px;position:relative;transition:border-color .2s}
.coin-card:hover{border-color:var(--line2)}
.coin-card.diverged{border-color:rgba(201,162,77,.55)}
.coin-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:8px}
.coin-sym{font-family:var(--serif);font-size:17px;letter-spacing:.5px}
.coin-price{font-family:var(--mono);font-size:15px;margin:6px 0 2px}
.conf-bar{height:4px;background:var(--bg2);border-radius:2px;margin:9px 0 6px;overflow:hidden}
.conf-fill{height:100%;background:var(--amber);border-radius:2px}
.coin-headline{font-size:12px;color:var(--text2);line-height:1.6;min-height:38px}
.coin-official{margin-top:9px;padding-top:8px;border-top:1px dashed var(--line);font-size:11px;color:var(--text3)}
.coin-official .of-tag{font-family:var(--mono);font-size:9.5px;letter-spacing:1px;text-transform:uppercase}

/* ---- 锁定卡 ---- */
.lock-card{background:var(--bg1);border:1px solid var(--line);border-radius:8px;padding:52px 30px;text-align:center;max-width:560px;margin:30px auto}
.lock-icon{font-size:34px;margin-bottom:14px;opacity:.85}
.lock-title{font-family:var(--serif);font-size:19px;margin-bottom:8px}
.lock-desc{color:var(--text2);font-size:13px;max-width:400px;margin:0 auto 20px}
.btn{background:var(--amber);color:#1a1408;border:none;font-size:13px;font-weight:600;padding:9px 22px;border-radius:5px;cursor:pointer;transition:.15s;font-family:var(--sans)}
.btn:hover{background:#e8b654}
.btn.secondary{background:var(--bg2);color:var(--text2);border:1px solid var(--line2);font-weight:400}
.btn.secondary:hover{border-color:var(--amber-dim);color:var(--amber);background:var(--bg2)}
.btn.danger{background:transparent;color:var(--red);border:1px solid rgba(192,106,94,.4)}
.btn.danger:hover{background:var(--red-soft)}
.btn.small{padding:4px 12px;font-size:12px}

/* ---- 表单 ---- */
.form-box{max-width:400px;margin:24px auto}
.field{margin-bottom:14px}
.field label{display:block;font-size:12px;color:var(--text2);margin-bottom:5px}
.field input{width:100%;background:var(--bg2);border:1px solid var(--line2);border-radius:5px;color:var(--text);font-size:14px;padding:9px 12px;outline:none;transition:.15s;font-family:var(--sans)}
.field input:focus{border-color:var(--amber-dim)}
.form-msg{font-size:12.5px;margin:10px 0;min-height:18px}
.form-msg.err{color:var(--red)}.form-msg.ok{color:var(--green)}
.form-switch{text-align:center;font-size:12.5px;color:var(--text2);margin-top:14px}

/* ---- 词典 ---- */
.glossary-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
@media(max-width:860px){.glossary-grid{grid-template-columns:1fr}}
.term{background:var(--bg1);border:1px solid var(--line);border-radius:6px;padding:13px 16px}
.term-en{font-family:var(--mono);font-size:13px;color:var(--amber);letter-spacing:.3px}
.term-zh{font-family:var(--serif);font-size:14px;margin:2px 0 6px}
.term-desc{font-size:12px;color:var(--text2);line-height:1.65}

/* ---- 图表 ---- */
.chart-box{background:var(--bg2);border:1px solid var(--line);border-radius:6px;padding:12px}
svg text{font-family:var(--mono)}
.legend{display:flex;gap:16px;font-size:11px;color:var(--text3);margin-top:6px;flex-wrap:wrap}
.legend span::before{content:"";display:inline-block;width:9px;height:9px;border-radius:2px;margin-right:5px;vertical-align:-1px}

/* ---- AI 日报时间线 ---- */
.timeline{position:relative;padding-left:22px}
.timeline::before{content:"";position:absolute;left:6px;top:6px;bottom:6px;width:1px;background:var(--line2)}
.tl-item{position:relative;margin-bottom:18px}
.tl-item::before{content:"";position:absolute;left:-19px;top:7px;width:7px;height:7px;border-radius:50%;background:var(--amber-dim);border:2px solid var(--bg0)}
.tl-date{font-family:var(--mono);font-size:11.5px;color:var(--amber);letter-spacing:1px}
.tl-src{font-family:var(--mono);font-size:10px;color:var(--text3);margin-left:8px}
.tl-text{font-size:13px;color:var(--text2);margin-top:3px;line-height:1.75}

/* ---- 倒计时 ---- */
.cond-card{background:var(--bg2);border:1px solid var(--line);border-radius:6px;padding:14px 16px;margin-bottom:12px}
.cond-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}
.cond-label{font-family:var(--serif);font-size:14.5px}
.cond-bucket{font-family:var(--mono);font-size:11px}
.progress{height:8px;background:var(--bg0);border-radius:4px;overflow:hidden;margin:8px 0 6px}
.progress-fill{height:100%;border-radius:4px;background:linear-gradient(90deg,var(--amber-dim),var(--amber));transition:width .5s}
.cond-line{font-size:12px;color:var(--text2)}

/* ---- 数据时间/stale ---- */
.data-ts{font-family:var(--mono);font-size:10.5px;color:var(--text3);letter-spacing:.5px}
.data-ts.stale{color:var(--red);opacity:.75}
.stale-tag{font-family:var(--mono);font-size:9.5px;color:var(--red);border:1px solid rgba(192,106,94,.4);padding:1px 6px;border-radius:3px;margin-left:6px}
.stale-dim{opacity:.55;filter:grayscale(.4)}

/* ---- 后台 ---- */
.admin-grid{display:grid;grid-template-columns:1.4fr 1fr;gap:16px}
@media(max-width:960px){.admin-grid{grid-template-columns:1fr}}
.health-row{display:flex;justify-content:space-between;align-items:center;padding:7px 4px;border-bottom:1px solid var(--line);font-size:12.5px}
.kv-strip{display:flex;gap:18px;flex-wrap:wrap;font-family:var(--mono);font-size:12px;color:var(--text2);margin-bottom:14px}
.kv-strip b{color:var(--amber);font-weight:400}
.trigger-grid{display:flex;gap:8px;flex-wrap:wrap}

/* ---- 页脚 ---- */
footer{max-width:1280px;margin:30px auto 0;padding:18px 20px 26px;border-top:1px solid var(--line);font-family:var(--mono);font-size:10.5px;color:var(--text3);display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}
.toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:var(--bg3);border:1px solid var(--line2);color:var(--text);font-size:13px;padding:10px 20px;border-radius:6px;z-index:99;opacity:0;transition:.3s;pointer-events:none}
.toast.show{opacity:1}
.empty{color:var(--text3);font-size:12.5px;padding:20px;text-align:center;font-style:italic}

/* ---- 系统监控：进度条 ---- */
.mon-bar{display:flex;align-items:center;gap:8px;font-family:var(--mono);font-size:12px;color:var(--text2)}
.mon-bar .bar-track{flex:1;height:8px;background:var(--bg2);border-radius:4px;overflow:hidden;max-width:200px}
.mon-bar .bar-fill{height:100%;border-radius:4px;transition:width .4s}
.mon-bar .bar-fill.green{background:var(--green)}
.mon-bar .bar-fill.yellow{background:var(--yellow)}
.mon-bar .bar-fill.orange{background:#c97d3a}
.mon-bar .bar-fill.red{background:var(--red)}
.mon-bar .bar-label{min-width:70px;text-align:right;color:var(--text)}

/* ---- 系统监控：进程卡片 ---- */
.proc-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px}
@media(max-width:700px){.proc-grid{grid-template-columns:1fr}}
.proc-card{background:var(--bg1);border:1px solid var(--line);border-radius:6px;padding:10px 12px;font-family:var(--mono);font-size:11px;transition:.15s}
.proc-card:hover{border-color:var(--line2);background:var(--bg2)}
.proc-card .proc-name{color:var(--amber);font-size:12px;font-weight:500}
.proc-card .proc-stat{display:flex;gap:12px;flex-wrap:wrap;margin-top:5px;color:var(--text3)}
.proc-card .proc-stat span{white-space:nowrap}
.proc-card .proc-stat b{color:var(--text2);font-weight:400}


.news-bar{display:flex;gap:8px;align-items:center;margin-bottom:14px;flex-wrap:wrap}
.news-bar .src-btn{padding:4px 12px;border-radius:12px;font-size:12px;cursor:pointer;border:1px solid var(--line);background:transparent;color:var(--text2);transition:all .15s}
.news-bar .src-btn.active{background:var(--amber);color:#000;border-color:var(--amber)}
.news-bar .src-btn:hover{border-color:var(--amber)}
.news-item{display:flex;gap:12px;padding:12px 0;border-bottom:1px solid var(--line);transition:background .1s}
.news-item:last-child{border-bottom:none}
.news-item:hover{background:var(--bg2);margin:0 -12px;padding:12px calc(12px);border-radius:6px}
.news-influence{flex:none;width:40px;text-align:center;font-size:11px;color:var(--text2);padding-top:2px}
.news-influence .stars{font-size:10px;letter-spacing:1px}
.news-body{flex:1;min-width:0}
.news-body .news-title{font-size:14px;font-weight:500;color:var(--text);margin-bottom:4px;cursor:pointer;display:inline}
.news-body .news-title:hover{color:var(--amber)}
.news-body .news-content{font-size:12px;color:var(--text2);line-height:1.5;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.news-meta{display:flex;gap:10px;align-items:center;margin-top:6px;font-size:11px;color:var(--text3);flex-wrap:wrap}
.news-meta .news-src{padding:1px 6px;border-radius:4px;font-size:10px;background:var(--line);color:var(--text2)}
.news-meta .news-time{color:var(--text3)}
.news-tag{display:inline-flex;align-items:center;gap:3px;padding:1px 7px;border-radius:4px;font-size:10px;font-weight:600;margin-right:6px}
.news-tag.bullish{background:#1a3a2a;color:#5f9e7a}
.news-tag.bearish{background:#3a1a1a;color:#c06a5e}
.news-tag.neutral{background:#2a2a1a;color:#a99a41}
.news-empty{text-align:center;padding:60px 20px;color:var(--text3)}
.news-loading{text-align:center;padding:40px;color:var(--text2)}
.news-refresh{font-size:11px;color:var(--text3);cursor:pointer}
.news-refresh:hover{color:var(--amber)}
.news-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;flex-wrap:wrap;gap:8px}
.news-header .src-legend{display:flex;gap:12px;font-size:11px;color:var(--text3)}
.news-header .src-legend span{display:flex;align-items:center;gap:4px}
.news-header .src-legend .dot{width:8px;height:8px;border-radius:50%;display:inline-block}

function gaugeSVG(score,min,max,opts){ // posture -5..+5 / fgi 0..100
  const o=Object.assign({size:200,label:'',color:'#d9a441'},opts||{});
  const frac=Math.max(0,Math.min(1,(score-min)/(max-min)));
  const cx=100,cy=95,r=78;
  const arc=(a0,a1,rad)=>{const p=a=>[cx+rad*Math.cos(Math.PI*(1-a)),cy-rad*Math.sin(Math.PI*(1-a))];const[x0,y0]=p(a0),[x1,y1]=p(a1);return`M ${x0} ${y0} A ${rad} ${rad} 0 0 1 ${x1} ${y1}`};
  const na=frac; // 0..1 映射半圆
  const nx=cx+r*Math.cos(Math.PI*(1-na)),ny=cy-r*Math.sin(Math.PI*(1-na));
  let ticks='';
  for(let i=0;i<=10;i++){const a=i/10,tx1=cx+(r-8)*Math.cos(Math.PI*(1-a)),ty1=cy-(r-8)*Math.sin(Math.PI*(1-a)),tx2=cx+(r-2)*Math.cos(Math.PI*(1-a)),ty2=cy-(r-2)*Math.sin(Math.PI*(1-a));ticks+=`<line x1="${tx1}" y1="${ty1}" x2="${tx2}" y2="${ty2}" stroke="#3c424d" stroke-width="1.5"/>`}
  const zoneColor=frac<0.33?'#c06a5e':frac<0.66?'#d9a441':'#5f9e7a';
  return `<svg viewBox="0 0 200 115" width="${o.size}" height="${o.size*0.575}">
    <path d="${arc(0,1,r)}" fill="none" stroke="#2a2f38" stroke-width="11" stroke-linecap="round"/>
    <path d="${arc(0,na,r)}" fill="none" stroke="${zoneColor}" stroke-width="11" stroke-linecap="round"/>
    ${ticks}
    <line x1="${cx}" y1="${cy}" x2="${nx*0.92+cx*0.08}" y2="${ny*0.92+cy*0.08}" stroke="#d8d5cd" stroke-width="2" transform="rotate(0 ${cx} ${cy})"/>
    <circle cx="${cx}" cy="${cy}" r="4" fill="#d8d5cd"/>
    <text x="18" y="112" fill="#6d6a62" font-size="9">${min}</text>
    <text x="176" y="112" fill="#6d6a62" font-size="9">${max}</text>
    <text x="100" y="112" fill="#6d6a62" font-size="8.5" text-anchor="middle">${esc(o.label)}</text>
  </svg>`;
}
function lineChartSVG(points,opts){ // points:[{x:label,y:value}] 或 [number]
  const o=Object.assign({w:640,h:200,color:'#d9a441',fill:true,yLabel:v=>v},opts||{});
  const vals=points.map(p=>typeof p==='number'?p:p.y);
  if(!vals.length)return'<div class="empty">no data</div>';
  const min=Math.min(...vals),max=Math.max(...vals),span=(max-min)||1;
  const pad={l:34,r:8,t:10,b:18};
  const W=o.w,H=o.h,iw=W-pad.l-pad.r,ih=H-pad.t-pad.b;
  const xy=(i,v)=>[pad.l+iw*(vals.length===1?0.5:i/(vals.length-1)),pad.t+ih*(1-(v-min)/span)];
  const path=vals.map((v,i)=>{const[x,y]=xy(i,v);return(i?'L':'M')+x.toFixed(1)+' '+y.toFixed(1)}).join(' ');
  const area=path+` L ${xy(vals.length-1,min)[0]} ${pad.t+ih} L ${xy(0,min)[0]} ${pad.t+ih} Z`;
  let grid='';
  for(let i=0;i<=3;i++){const v=min+span*i/3,y=pad.t+ih*(1-i/3);grid+=`<line x1="${pad.l}" y1="${y}" x2="${W-pad.r}" y2="${y}" stroke="#31363f" stroke-width="0.5"/><text x="${pad.l-4}" y="${y+3}" fill="#6d6a62" font-size="8" text-anchor="end">${esc(o.yLabel(v))}</text>`}
  const dot=xy(vals.length-1,vals[vals.length-1]);
  return `<svg viewBox="0 0 ${W} ${H}" width="100%" preserveAspectRatio="xMidYMid meet" style="max-height:${H+20}px">
    ${grid}
    ${o.fill?`<path d="${area}" fill="${o.color}" opacity="0.10"/>`:''}
    <path d="${path}" fill="none" stroke="${o.color}" stroke-width="1.6"/>
    <circle cx="${dot[0]}" cy="${dot[1]}" r="3" fill="${o.color}"/>
    <text x="${dot[0]-4}" y="${dot[1]-7}" fill="${o.color}" font-size="9" text-anchor="end">${esc(String(Math.round(vals[vals.length-1]*100)/100))}</text>
  </svg>`;
}
function barChartSVG(items,opts){ // items:[{label,value,color?}]
  const o=Object.assign({w:640,h:220,color:'#d9a441'},opts||{});
  if(!items.length)return'<div class="empty">no data</div>';

<script>
'use strict';
/* ================= SVG 图表助手 ================= */
/* ================= PANEL: 总览 ================= */
const PANELS={};

PANELS.news=async function(){startTabTimer("news",PANELS.news);
  const main=$("#main");
  main.innerHTML=`<div class="news-header">
    <div class="news-bar" id="newsSrcBar">
      <button class="src-btn active" data-src="all">${T("全部","All")}</button>
      <button class="src-btn" data-src="odaily">深潮</button>
      <button class="src-btn" data-src="blockbeats">律动</button>
      <button class="src-btn" data-src="chainthink">链智库</button>
    </div>
    <div class="src-legend">
      <span><span class="dot" style="background:#5f9e7a"></span>${T("利多","Bullish")}</span>
      <span><span class="dot" style="background:#c06a5e"></span>${T("利空","Bearish")}</span>
      <span class="news-refresh" id="newsRefreshBtn">⟳ ${T("刷新","Refresh")}</span>
    </div>
  </div>
  <div id="newsList"><div class="news-loading">${T("加载中…","Loading...")}</div></div>`;
  const render=(src)=>{loadNews(src)};
  $$("#newsSrcBar .src-btn").forEach(b=>b.onclick=()=>{
    $$("#newsSrcBar .src-btn").forEach(x=>x.classList.remove("active"));
    b.classList.add("active");
    render(b.dataset.src);
  });
  $("#newsRefreshBtn").onclick=async()=>{
    $("#newsRefreshBtn").textContent="${T("⟳ 刷新中…","⟳ Refreshing...")}";
    await api("/api/news/refresh",{method:"POST",body:"{}"});
    render(document.querySelector("#newsSrcBar .src-btn.active").dataset.src);
    setTimeout(()=>$("#newsRefreshBtn").textContent="⟳ ${T("刷新","Refresh")}",1000);
  };
  render("all");
};

async function loadNews(src){
  const el=$("#newsList");
  if(!el)return;
  const r=await api("/api/news");
  if(!r.ok||!r.items){el.innerHTML=`<div class="news-empty">${T("加载失败","Load failed")}</div>`;return}
  let items=r.items;
  if(src!=="all")items=items.filter(i=>i.source===src);
  if(!items.length){el.innerHTML=`<div class="news-empty">${T("暂无消息","No news")}</div>`;return}
  const now=Date.now();
  el.innerHTML=items.map((n,i)=>{
    const dt=n.ts?fmtDate(n.ts*1000):n.time||"";
    const sentCls=n.sentiment||"neutral";
    const sentLabel={bullish:"${T("利多","Bullish")}",bearish:"${T("利空","Bearish")}",neutral:"${T("中性","Neutral")}"}[sentCls];
    const inf=n.influence||1;
    const stars="★".repeat(inf)+"☆".repeat(5-inf);
    const url=n.url||n.sourceUrl||"";
    return `<div class="news-item" style="animation:fadeIn .25s ${i*0.03}s both">
      <div class="news-influence"><div class="stars">${stars}</div><div style="font-size:9px;margin-top:2px">${inf}</div></div>
      <div class="news-body">
        <div>
          <span class="news-tag ${sentCls}">${sentLabel}</span>
          <a class="news-title" href="${esc(url)}" target="_blank" rel="noopener">${esc(n.title||n.content.slice(0,60))}</a>
        </div>
        <div class="news-content">${esc(n.content?n.content.slice(0,200):"")}</div>
        <div class="news-meta">
          <span class="news-src">${esc(n.sourceLabel||n.source)}</span>
          <span class="news-time">${dt}</span>
        </div>
      </div>
    </div>`;
  }).join("");
}

function fmtDate(ts){
  const d=new Date(ts);
  const now=new Date();
  const diff=now-d;
  if(diff<60000)return "${T("刚刚","just now")}";
  if(diff<3600000)return Math.floor(diff/60000)+"${T("分钟前","m ago")}";
  if(diff<86400000)return Math.floor(diff/3600000)+"${T("小时前","h ago")}";
  const mm=(d.getMonth()+1).toString().padStart(2,"0");
  const dd=d.getDate().toString().padStart(2,"0");
  const hh=d.getHours().toString().padStart(2,"0");
  const mi=d.getMinutes().toString().padStart(2,"0");
  if(d.getFullYear()===now.getFullYear())return mm+"/"+dd+" "+hh+":"+mi;
  return d.getFullYear()+"/"+mm+"/"+dd+" "+hh+":"+mi;
}

PANELS.overview=async function(){startTabTimer('overview',PANELS.overview);
  const main=$('#main');
  main.innerHTML='<div class="card">\u52a0\u8f7d\u4e2d\u2026</div>';
  try{
    const d=await api('/api/overview');
    if(!d.ok){main.innerHTML='<div class="card">\u6570\u636e\u4e0d\u53ef\u7528</div>';return}
    var v=d.verdict||{},p=d.posture||{},off=d.official||null;
    var badgeCls=p&&p.state?p.state:'neutral';
    var score=(p&&p.score!=null)?('<span class="badge '+badgeCls+'">'+Number(p.score).toFixed(1)+'</span>'):'<span class="badge neutral">--</span>';
    var days=p&&p.days_held!=null?'\u5df2\u7ef4\u6301 '+p.days_held+' \u5929':'';
    var headline=state.lang==='zh'?(v.headline_zh||''):(v.headline_en||'');
    // OI\u6570\u636e
    var oiHtml='<div class="empty" id="oi-data">\u52a0\u8f7d OI\u2026</div>';
    main.innerHTML='<div class="card"><div class="card-title">William \u59ff\u6001\u8bc4\u5206 <span style="margin-left:auto">'+score+' '+days+'</span></div>'
      +'<div class="verdict-block">'+esc(headline)+'</div>'
      +'</div>'
      +'<div class="card"><div class="card-title">\u6743\u91cd\u56e0\u5b50\u4e0e\u8f6c\u53d8\u89e6\u53d1</div>'
      +'<div class="verdict-block" style="font-size:12px;line-height:1.7">'
      +'<b>\u4e3b\u56e0\uff1a</b>'+esc(state.lang==='zh'?(p.reason_zh||p.rationale_zh||''):(p.reason_en||p.rationale_en||''))+'<br>'
      +'<b>\u8f6c\u53d8\u89e6\u53d1\uff1a</b>'+esc(state.lang==='zh'?(p.flip_trigger_zh||''):(p.flip_trigger_en||''))
      +'</div></div>'
      +'<div class="card"><div class="card-title">\u6301\u4ed3\u91cf\uff08OI\uff09\u6458\u8981<span style="margin-left:auto" id="oi-ts"></span></div>'
      +'<div id="oi-data">'+oiHtml+'</div></div>'
      +'<div class="card"><div class="card-title">\u65b9\u6cd5\u5b66</div>'
      +'<div class="verdict-block" style="font-size:11px;color:#888;line-height:1.6">'
      +'Gate \u73b0\u8d27 60s \u4e00\u843d\u5e93\uff1bCoinglass \u5408\u7ea6\u5e02\u573a 120s\uff1bLSR \u591a\u7a7a\u53cc\u699c\u4e0e\u8d39\u7387\u5957\u5229 300s\uff1bKOL \u5171\u8bc6 600s\uff1b\u6050\u60e7\u8d2a\u5a6a 1800s\uff1bWilliam \u5f52\u6863\u6574\u5305\u6bcf\u5c0f\u65f6\u5f52\u6863\uff08\u4fdd\u7559 400 \u5929\uff09\u3002\u524d\u7aef\u53ea\u8bfb\u672c\u5730 SQLite\uff0c\u6c38\u4e0d\u7a7f\u900f\u6253\u4e0a\u6e38\u3002\u6570\u636e\u4ec5\u4f9b\u7814\u7a76\uff0c\u4e0d\u6784\u6210\u6295\u8d44\u5efa\u8bae\u3002'
      +'</div></div>';
    // \u5f02\u6b65\u52a0\u8f7d OI
    fetch('/api/oi-summary').then(function(r){return r.json()}).then(function(oi){
      if(!oi||!oi.ok)return;
      var pct=oi.avg_oi_change_24h_pct||0;
      var clr=pct>=3?'#5f9e7a':pct>=1?'#8ab87a':pct>=-0.5?'#d9a441':pct>=-2?'#c06a5e':'#a04040';
      var label=pct>=3?'\u6781\u5ea6\u770b\u6da8':pct>=1?'\u770b\u6da8':pct>=-0.5?'\u4e2d\u6027':pct>=-2?'\u504f\u5f31':'\u770b\u8dcc';
      var barW=Math.min(100,Math.max(0,(pct+5)/10*100));
      document.getElementById('oi-data').innerHTML='<div style="display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-bottom:6px">'
        +'<div style="background:#1c1e24;padding:6px 8px;border-radius:4px"><div style="font-size:10px;color:#888">\u5168\u5e02\u573a OI</div><div style="font-size:14px;font-weight:600">'+fmtUsd(oi.total_oi_usd)+'</div></div>'
        +'<div style="background:#1c1e24;padding:6px 8px;border-radius:4px"><div style="font-size:10px;color:#888">24h \u53d8\u5316</div><div style="font-size:14px;font-weight:600;color:'+clr+'">'+(pct>=0?'+':'')+pct.toFixed(2)+'%</div></div>'
        +'<div style="background:#1c1e24;padding:6px 8px;border-radius:4px"><div style="font-size:10px;color:#888">BTC OI</div><div style="font-size:14px;font-weight:600">'+fmtUsd(oi.btc_oi_usd)+'</div></div>'
        +'<div style="background:#1c1e24;padding:6px 8px;border-radius:4px"><div style="font-size:10px;color:#888">BTC \u5e02\u5360\u7387</div><div style="font-size:14px;font-weight:600;color:#d9a441">'+(oi.btc_dominance!=null?oi.btc_dominance.toFixed(1)+'%':'\u2014')+'</div></div>'
        +'</div>'
        +'<div style="display:flex;justify-content:space-between;font-size:10px;color:#888;margin-bottom:2px"><span>OI \u4fe1\u5fc3</span><span style="color:'+clr+'">'+label+'</span></div>'
        +'<div style="display:flex;align-items:center;gap:8px"><div style="flex:1;height:14px;border-radius:7px;background:#1a1c21;overflow:hidden">'
        +'<div style="height:100%;border-radius:7px;width:'+barW+'%;background:'+clr+'"></div></div>'
        +'<div style="font-size:12px;min-width:50px;text-align:right;color:'+clr+'">'+(pct>=0?'+':'')+pct.toFixed(2)+'%</div></div>';
      var tsEl=document.getElementById('oi-ts');
      if(tsEl)tsEl.innerHTML=dataTsHtml(oi.data_ts,false);
    }).catch(function(){});
  }catch(e){main.innerHTML='<div class="card">\u52a0\u8f7d\u5f02\u5e38: '+esc(e.message)+'</div>';}
};


PANELS.onchain=async function(){startTabTimer('onchain',PANELS.onchain);
  const main=$('#main');
  main.innerHTML='<div class="card">加载中…</div>';
  try{
    const d=await fetch('/api/onchain').then(function(r){return r.json()});
    if(!d||!d.ok){main.innerHTML='<div class="card">数据不可用</div>';return}
    var whales=(d.whales||[]).slice(0,15);
    var moves=(d.big_moves||[]).slice(0,15);
    var btcTxs=(d.btc_whale_txs||[]).slice(0,15);
    var whaleRows=whales.map(function(w,i){
      var delta=w.delta!=null?('<span style="color:'+(w.delta>=0?'#5f9e7a':'#c06a5e')+'">'+(w.delta>=0?'+':'')+Number(w.delta).toFixed(2)+'%</span>'):'<span style="color:#888">--</span>';
      var lr=w.long_short_ratio!=null?Number(w.long_short_ratio).toFixed(2):'--';
      return '<tr><td class="num">'+(i+1)+'</td><td>'+esc(w.symbol||'?')+'</td><td>'+esc(w.exchange||'?')+'</td><td class="num">'+lr+'</td><td class="num">'+delta+'</td></tr>';
    }).join('');
    var moveRows=moves.map(function(m,i){
      var oiChg=m.oi_chg_24h;
      var cls=oiChg>=0?'num pos':'num neg';
      var sign=oiChg>=0?'+':'';
      return '<tr><td class="num">'+(i+1)+'</td><td>'+esc(m.symbol)+'</td><td class="num '+cls+'">'+sign+Number(oiChg).toFixed(2)+'%</td><td class="num">'+fmtUsd(m.oi_usd)+'</td><td class="num">'+fmtPrice(m.price)+'</td></tr>';
    }).join('');
    var btcRows=btcTxs.map(function(tx,i){
      var txShort=esc(tx.txid.slice(0,12)+'...'+tx.txid.slice(-6));
      var usdVal=tx.value_usd?'$'+(tx.value_usd>=1e9?(tx.value_usd/1e9).toFixed(2)+'B':(tx.value_usd/1e6).toFixed(0)+'M'):'--';
      return '<tr><td class="num">'+(i+1)+'</td><td title="'+esc(tx.txid)+'" style="font-family:mono;font-size:10px">'+txShort+'</td><td class="num">'+Number(tx.value_btc).toFixed(2)+' BTC</td><td class="num">'+usdVal+'</td></tr>';
    }).join('');
    var tsHtml=(d.data_ts?'<span class="data-ts">数据 '+fmtTs(d.data_ts)+'</span>':'');
    main.innerHTML='<div class="card"><div class="card-title">🔍 BTC 巨鲸交易流</div>'
      +(btcRows?'<div style="overflow-x:auto"><table><thead><tr><th>#</th><th>交易ID</th><th>金额</th><th>美元价值</th></tr></thead><tbody>'+btcRows+'</tbody></table></div>':'<div class="empty">暂无巨鲸交易</div>')
      +'<div class="data-ts" style="margin-top:6px">来源: mempool.space 实时内存池</div></div>'
      +'<div class="card"><div class="card-title">🐋 巨鲸地址监控 · LSR 大户榜单</div>'
      +(whaleRows?'<div style="overflow-x:auto"><table><thead><tr><th>#</th><th>币种</th><th>交易所</th><th>多空比</th><th>24h Delta</th></tr></thead><tbody>'+whaleRows+'</tbody></table></div>':'<div class="empty">暂无巨鲸数据</div>')
      +'<div class="data-ts" style="margin-top:6px">来源: Coinglass LSR 大户榜单</div></div>'
      +'<div class="card"><div class="card-title">📊 大额 OI 异动 · 24h 持仓量变化 TOP15</div>'
      +(moveRows?'<div style="overflow-x:auto"><table><thead><tr><th>#</th><th>币种</th><th>OI 24h</th><th>持仓量</th><th>价格</th></tr></thead><tbody>'+moveRows+'</tbody></table></div>':'<div class="empty">暂无异常数据</div>')
      +'<div class="data-ts" style="margin-top:6px">来源: Coinglass 合约市场</div></div>'
      +'<div class="card"><div class="card-title">数据说明</div>'
      +'<div class="verdict-block" style="font-size:12px;line-height:1.7">'
      +'BTC 巨鲸交易来自 mempool.space 内存池，展示当前等待确认的 >10 BTC 大额交易。'
      +'LSR 大户榜单来自 Coinglass，反映各币种大户多空方向变化。'
      +'OI 异动标记 24h 持仓量变化最大的合约市场。以上数据仅供研究，不构成投资建议。'
      +'</div></div>';
  }catch(e){main.innerHTML='<div class="card">加载异常: '+esc(e.message)+'</div>';}
};;

'use strict';
/* ================= PANEL: 8币立场 ================= */
PANELS.coins=async function(){startTabTimer('coins',PANELS.coins);
  const main=$('#main');
  main.innerHTML='<div class="card">加载中…</div>';
  const d=await api('/api/coins');
  if(!d.ok){main.innerHTML='<div class="card">数据不可用</div>';return}
  const cards=d.coins.map(c=>{
    const confPct=Math.round((c.confidence||0)*100);
    return `<div class="coin-card${c.diverged?' diverged':''}">
      <div class="coin-head">
        <span class="coin-sym">${esc(c.symbol)}</span>
        <span class="badge ${c.stance}">${state.lang==='zh'?stanceZh(c.stance):stanceEn(c.stance)}</span>
      </div>
      <div class="coin-price num">${fmtPrice(c.price)} <span class="${cls(c.change_24h)}" style="font-size:12px">${fmtPct(c.change_24h)}</span></div>
      <div class="data-ts">${T('资金费率','funding')} ${c.funding!=null?(c.funding*100).toFixed(4)+'%':'—'}</div>
      <div class="conf-bar"><div class="conf-fill" style="width:${confPct}%"></div></div>
      <div class="data-ts">confidence ${confPct}% · <span class="dot ${c.status&&c.status.code==='strengthened'?'g':c.status&&c.status.code==='watch'?'y':'gray'}"></span>${c.status?esc(c.status.code):''}</div>
      <div class="coin-headline" style="margin-top:8px">${esc(state.lang==='zh'?c.headline_zh:c.headline_en)}</div>
      <div class="coin-official">
        <span class="of-tag">William archive</span><br>
        ${c.official?`<span class="badge ${c.official.stance}" style="margin-top:4px">${esc(c.official.stance)}</span>
        ${c.diverged?`<span class="badge diverge" style="margin-left:5px">${T('分歧','DIFF')}</span>`:`<span class="data-ts" style="margin-left:5px">${T('一致','aligned')}</span>`}`:'<span class="data-ts">—</span>'}
      </div>
    </div>`;
  }).join('');
  main.innerHTML=`<div class="card">
    <div class="card-title">${T('8 币立场引擎','8-Coin Stance Engine')}
      <span class="data-ts" style="margin-left:8px">${T('黄框 = 与官方分歧','amber border = divergence')}</span>
      <span style="margin-left:auto">${dataTsHtml(d.data_ts,d.stale)}</span></div>
    <div class="coin-grid">${cards}</div></div>`;
};

/* ================= PANEL: 情绪 ================= */
PANELS.sentiment=async function(){startTabTimer('sentiment',PANELS.sentiment);
  const main=$('#main');
  main.innerHTML='<div class="card">加载中…</div>';
  const d=await api('/api/fear-greed');
  if(!d.ok){main.innerHTML='<div class="card">数据不可用</div>';return}
  const cur=d.current||{value:null,classification:'—'};
  const fgZh=v=>v==null?'—':v<=25?'极度恐惧':v<=45?'恐惧':v<=55?'中性':v<=75?'贪婪':'极度贪婪';
  const series=d.series.map(p=>p.value);
  const labels=d.series.map(p=>new Date(p.ts*1000).toLocaleDateString('zh-CN',{month:'2-digit',day:'2-digit',timeZone:'Asia/Shanghai'}));
  const zone=cur.value<=25?'#c06a5e':cur.value<=45?'#d9a441':cur.value<=55?'#9d998f':cur.value<=75?'#8aa37a':'#5f9e7a';
  main.innerHTML=`
  <div class="grid2">
    <div class="card">
      <div class="card-title">${T('恐惧与贪婪指数','Fear & Greed Index')}
        <span style="margin-left:auto">${dataTsHtml(d.data_ts,d.stale)}</span></div>
      <div class="gauge-wrap">
        ${gaugeSVG(cur.value||50,0,100,{size:260,label:'FGI 0..100'})}
        <div class="gauge-score" style="color:${zone}">${cur.value??'—'}</div>
        <div class="gauge-state">${state.lang==='zh'?fgZh(cur.value):esc(cur.classification||'')}</div>
      </div>
      <div class="verdict-block" style="margin-top:14px">${T('极端读数常对应反向机会：极度恐惧区往往是中长期买点观察窗，极度贪婪区则需要警惕杠杆过热。','Extreme readings are often contrarian: extreme fear marks accumulation windows; extreme greed warns of overheated leverage.')}</div>
    </div>
    <div class="card">
      <div class="card-title">${T('90 天序列','90-Day Series')}</div>
      <div class="chart-box">${lineChartSVG(series,{color:'#d9a441',yLabel:v=>Math.round(v)})}</div>
      <div class="legend"><span>${esc(labels[0]||'')}</span><span style="margin-left:auto">${esc(labels[labels.length-1]||'')}</span></div>
      <div class="kv-strip" style="margin-top:10px">
        <span>min <b>${series.length?Math.min(...series):'—'}</b></span>
        <span>max <b>${series.length?Math.max(...series):'—'}</b></span>
        <span>7d Δ <b>${series.length>=8?(series[series.length-1]-series[series.length-8]):'—'}</b></span>
        <span>30d Δ <b>${series.length>=31?(series[series.length-1]-series[series.length-31]):'—'}</b></span>
      </div>
    </div>
  </div>`;
};

/* ================= PANEL: 资金流 ================= */
PANELS.flows=async function(){startTabTimer('flows',PANELS.flows);
  const main=$('#main');
  main.innerHTML='<div class="card">\u52a0\u8f7d\u4e2d\u2026</div>';
  try{
  const d=await api('/api/etf-flows');
  const oi=await api('/api/oi-summary');
  if(!d.ok)throw new Error('etf api failed');
  const etf=(d.etf_btc_flow_14d||[]).map(function(x){return{label:x.label||x.date||'',value:Math.round(x.value*10)/10}});
  const dom=(d.proxies.dominance_30d||[]).map(function(x){return x.value});
  var p=oi&&oi.ok?(oi.avg_oi_change_24h_pct||0):0;
  var c=p>=3?'#5f9e7a':p>=1?'#8ab87a':p>=-0.5?'#d9a441':p>=-2?'#c06a5e':'#a04040';
  var oiText='';
  if(oi&&oi.ok){
    oiText='<div style="display:grid;grid-template-columns:1fr 1fr;gap:6px;margin:6px 0">'
      +'<div style="background:#1c1e24;padding:6px 8px;border-radius:4px"><div style="font-size:10px;color:#888">\u5168\u5e02\u573a OI</div><div style="font-size:14px;font-weight:600">'+fmtUsd(oi.total_oi_usd)+'</div></div>'
      +'<div style="background:#1c1e24;padding:6px 8px;border-radius:4px"><div style="font-size:10px;color:#888">24h \u53d8\u5316</div><div style="font-size:14px;font-weight:600;color:'+c+'">'+(p>=0?'+':'')+p.toFixed(2)+'%</div></div>'
      +'<div style="background:#1c1e24;padding:6px 8px;border-radius:4px"><div style="font-size:10px;color:#888">BTC OI</div><div style="font-size:14px;font-weight:600">'+fmtUsd(oi.btc_oi_usd)+'</div></div>'
      +'<div style="background:#1c1e24;padding:6px 8px;border-radius:4px"><div style="font-size:10px;color:#888">BTC \u5e02\u5360\u7387</div><div style="font-size:14px;font-weight:600;color:#d9a441">'+(oi.btc_dominance!=null?oi.btc_dominance.toFixed(1)+'%':'\u2014')+'</div></div></div>'
      +'<div style="font-size:10px;color:#888;margin-top:4px">'+(p>=3?'\ud83d\udfe2 OI \u5927\u5e45\u4e0a\u5347':p>=1?'\ud83d\udfe2 OI \u6e29\u548c\u4e0a\u5347':p>=-0.5?'\ud83d\udfe1 OI \u57fa\u672c\u6301\u5e73':p>=-2?'\ud83d\udfe0 OI \u5c0f\u5e45\u4e0b\u964d':'\ud83d\udd34 OI \u663e\u8457\u4e0b\u964d')+'</div>';
  }else{oiText='<div class="empty">OI \u6570\u636e\u6682\u4e0d\u53ef\u5f97</div>';}
  main.innerHTML='<div class="card"><div class="card-title">ETF \u6bd4\u7279\u5e01 14 \u65e5\u8d44\u91d1\u6d41</div>'
    +(etf.length?'<div class="chart-box">'+barChartSVG(etf)+'</div>':'<div class="empty">ETF \u6570\u636e\u6682\u65e0</div>')
    +'<div class="kv-strip" style="margin-top:8px"><span>\u8fd13\u65e5\u5408\u8ba1</span><b>'+(d.etf_recent3_musd>=0?'+':'')+Math.round(d.etf_recent3_musd||0)+'M</b></span>ETF \u63a8\u52a8\u60c5\u7eea\u6307\u6570</div>'
    +(function(){
      var flow=d.etf_recent3_musd||0;
      // \u8ba1\u7b97\u6307\u6570: 0-100, \u57fa\u51c6\u8303\u56f4 -1000~+1000M
      var idx=Math.min(100,Math.max(0,(flow+1000)/2000*100));
      var color=idx<25?'#c06a5e':idx<45?'#d9a441':idx<55?'#8ab87a':'#5f9e7a';
      var label=idx<25?'\u6781\u5ea6\u60b2\u89c2':idx<45?'\u504f\u60b2\u89c2':idx<55?'\u4e2d\u6027':idx<75?'\u504f\u4e50\u89c2':'\u6781\u5ea6\u4e50\u89c2';
      return '<div style="margin-top:10px">'
        +'<div style="display:flex;justify-content:space-between;font-size:11px;color:#888;margin-bottom:4px">'
        +'<span>'+(flow>=0?'\u6d41\u5165 '+(Math.round(flow))+'M':'\u6d41\u51fa '+(Math.round(Math.abs(flow)))+'M')+'</span>'
        +'<span style="color:'+color+';font-weight:600">'+label+'</span></div>'
        +'<div style="display:flex;align-items:center;gap:6px">'
        +'<span style="font-size:9px;color:#c06a5e">\u60b2\u89c2</span>'
        +'<div style="flex:1;height:14px;border-radius:7px;background:linear-gradient(to right,#c06a5e,#d9a441,#8ab87a,#5f9e7a);overflow:hidden;position:relative">'
        +'<div style="position:absolute;top:0;left:0;height:100%;width:'+idx+'%;background:rgba(255,255,255,0.35);border-radius:7px 0 0 7px"></div>'
        +'<div style="position:absolute;top:1px;left:'+(idx-1)+'%;height:12px;width:2px;background:white;border-radius:1px"></div>'
        +'</div>'
        +'<span style="font-size:9px;color:#5f9e7a">\u4e50\u89c2</span></div>'
        +'<div style="font-size:10px;color:#888;margin-top:4px">\u57fa\u4e8e ETF \u8fd13\u65e5\u6d41\u5165/\u6d41\u51fa\u603b\u989d\uff0c\u8303\u56f4 -1000M ~ +1000M</div></div>';
    })()
    +'<div class="card" id="flows-oi-card"><div class="card-title">\u6301\u4ed3\u91cf\uff08OI\uff09\u6458\u8981<span style="margin-left:auto" id="flows-oi-ts"></span></div><div id="flows-oi-data" class="empty">\u52a0\u8f7d\u4e2d\u2026</div></div>'+'<div class="card"><div class="card-title">BTC \u5e02\u5360\u7387 30 \u65e5</div>'
    +(dom.length?'<div class="chart-box">'+lineChartSVG(dom,{color:"#8aa37a",yLabel:function(v){return v.toFixed(1)+"%"}})+'</div>':'<div class="empty">\u2014</div>')
    +'<div class="kv-strip" style="margin-top:8px"><span>\u5f53\u524d</span><b>'+(d.proxies.btc_dominance!=null?Number(d.proxies.btc_dominance).toFixed(1)+'%':'\u2014')+'</b></span></div></div>'+'<div class="card" id="btc-chain-data"><div class="card-title">BTC \u94fe\u4e0a\u6307\u6807\u52a0\u8f7d\u4e2d\u2026</div></div>';
  
fetch('/api/oi-summary').then(function(r){return r.json()}).then(function(oi){
    if(!oi||!oi.ok)return;
    var pct=oi.avg_oi_change_24h_pct||0;
    var clr=pct>=3?'#5f9e7a':pct>=1?'#8ab87a':pct>=-0.5?'#d9a441':pct>=-2?'#c06a5e':'#a04040';
    var barW=Math.min(100,Math.max(0,(pct+5)/10*100));
    var el=document.getElementById('flows-oi-data');
    if(!el)return;
    el.innerHTML='<div style="display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-bottom:6px">'
      +'<div style="background:#1c1e24;padding:6px 8px;border-radius:4px"><div style="font-size:10px;color:#888">\u5168\u5e02\u573a OI</div><div style="font-size:14px;font-weight:600">'+fmtUsd(oi.total_oi_usd)+'</div></div>'
      +'<div style="background:#1c1e24;padding:6px 8px;border-radius:4px"><div style="font-size:10px;color:#888">24h \u53d8\u5316</div><div style="font-size:14px;font-weight:600;color:'+clr+'">'+(pct>=0?'+':'')+pct.toFixed(2)+'%</div></div>'
      +'<div style="background:#1c1e24;padding:6px 8px;border-radius:4px"><div style="font-size:10px;color:#888">BTC OI</div><div style="font-size:14px;font-weight:600">'+fmtUsd(oi.btc_oi_usd)+'</div></div>'
      +'<div style="background:#1c1e24;padding:6px 8px;border-radius:4px"><div style="font-size:10px;color:#888">BTC \u5e02\u5360\u7387</div><div style="font-size:14px;font-weight:600;color:#d9a441">'+(oi.btc_dominance!=null?oi.btc_dominance.toFixed(1)+'%':'\u2014')+'</div></div>'
      +'</div>'
      +'<div style="display:flex;justify-content:space-between;font-size:10px;color:#888;margin-bottom:2px"><span>OI \u4fe1\u5fc3</span><span style="color:'+clr+'">'+(pct>=3?'\u6781\u5ea6\u770b\u6da8':pct>=1?'\u770b\u6da8':pct>=-0.5?'\u4e2d\u6027':pct>=-2?'\u504f\u5f31':'\u770b\u8dcc')+'</span></div>'
      +'<div style="display:flex;align-items:center;gap:8px"><div style="flex:1;height:14px;border-radius:7px;background:#1a1c21;overflow:hidden">'
      +'<div style="height:100%;border-radius:7px;width:'+barW+'%;background:'+clr+'"></div></div>'
      +'<div style="font-size:12px;min-width:50px;text-align:right;color:'+clr+'">'+(pct>=0?'+':'')+pct.toFixed(2)+'%</div></div>';
    var tsEl=document.getElementById('flows-oi-ts');
    if(tsEl)tsEl.innerHTML=dataTsHtml(oi.data_ts,false);
  }).catch(function(){});
// BTC \u94fe\u4e0a\u6307\u6807
  fetch('/api/btc-onchain').then(function(r){return r.json()}).then(function(b){
    if(!b||!b.ok)return;
    var c=b.data;
    var eh=(c.hashrate_exa||'0')+' EH/s';
    var mcap='$'+(c.market_cap_usd>=1e12?(c.market_cap_usd/1e12).toFixed(2)+'T':(c.market_cap_usd/1e9).toFixed(0)+'B');
    document.getElementById('btc-chain-data').innerHTML='<div class="card-title">BTC \u94fe\u4e0a\u6307\u6807</div>'
      +'<div style="display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:6px;margin-top:8px">'
      +'<div class="oi-i"><div class="oi-l">\u4ef7\u683c</div><div class="oi-v">'+fmtPrice(c.price)+'</div></div>'
      +'<div class="oi-i"><div class="oi-l">\u5e02\u503c</div><div class="oi-v">'+mcap+'</div></div>'
      +'<div class="oi-i"><div class="oi-l">\u7b97\u529b</div><div class="oi-v">'+eh+'</div></div>'
      +'<div class="oi-i"><div class="oi-l">\u7f51\u7edc\u96be\u5ea6</div><div class="oi-v">'+(c.difficulty?(c.difficulty/1e12).toFixed(1)+'T':'--')+'</div></div>'
      +'<div class="oi-i"><div class="oi-l">24h \u4ea4\u6613</div><div class="oi-v">'+Number(c.transactions_24h||0).toLocaleString()+'</div></div>'
      +'<div class="oi-i"><div class="oi-l">\u5185\u5b58\u6c60</div><div class="oi-v">'+Number(c.mempool_txs||0).toLocaleString()+'</div></div>'
      +'<div class="oi-i"><div class="oi-l">\u5e73\u5747\u624b\u7eed\u8d39</div><div class="oi-v">'+(c.avg_tx_fee_usd?'$'+Number(c.avg_tx_fee_usd).toFixed(2):'--')+'</div></div>'
      +'<div class="oi-i"><div class="oi-l">\u8282\u70b9\u6570</div><div class="oi-v">'+Number(c.nodes||0).toLocaleString()+'</div></div>'
      +'<div class="oi-i"><div class="oi-l">\u533a\u5757\u9ad8\u5ea6</div><div class="oi-v">'+Number(c.block_height||0).toLocaleString()+'</div></div>'
      +'<div class="oi-i"><div class="oi-l">24h \u6700\u5927\u4ea4\u6613</div><div class="oi-v">'+(c.largest_tx_usd?'$'+(c.largest_tx_usd>=1e9?(c.largest_tx_usd/1e9).toFixed(2)+'B':(c.largest_tx_usd/1e6).toFixed(0)+'M'):'--')+'</div></div>'
      +'<div class="oi-i"><div class="oi-l">24h \u901a\u80c0</div><div class="oi-v">$'+Number((c.inflation_usd_24h||0)/1e6).toFixed(0)+'M</div></div>'
      +'</div>'
      +'<div style="font-size:10px;color:#888;margin-top:6px">\u6765\u6e90: Blockchair + mempool.space</div>';
  }).catch(function(){});


}catch(e){main.innerHTML='<div class="card">Error: '+esc(e.message)+'</div>';}
};PANELS.markets=async function(){
  const main=$('#main');
  async function draw(){
    const d=await api('/api/markets');
    if(!d.ok||state.tab!=='markets')return;
    const spotRows=(d.spot||[]).map(r=>`<tr>
      <td class="coin-sym" style="font-size:14px">${esc(r.symbol)}</td>
      <td class="num">${fmtPrice(r.price)}</td>
      <td class="num ${cls(r.change_24h)}">${fmtPct(r.change_24h)}</td>
      <td class="num">${fmtPrice(r.high_24h)}</td><td class="num">${fmtPrice(r.low_24h)}</td>
      <td class="num">${fmtUsd(r.volume)}</td></tr>`).join('');
    const futRows=(d.futures_top||[]).map((c,i)=>`<tr>
      <td class="num">${i+1}</td><td>${esc(c.symbol)}</td>
      <td class="num">${fmtPrice(c.price)}</td>
      <td class="num ${cls(c.change_24h)}">${fmtPct(c.change_24h)}</td>
      <td class="num ${cls((c.funding||0)*1e4)}">${c.funding!=null?(c.funding*100).toFixed(4)+'%':'—'}</td>
      <td class="num">${fmtUsd(c.oi_usd)}</td>
      <td class="num ${cls(c.oi_change_24h)}">${fmtPct(c.oi_change_24h)}</td></tr>`).join('');
    main.innerHTML=`
    <div class="card">
      <div class="card-title">${T('现货行情 · Gate 8 币','Spot · Gate 8 Coins')}
        <span style="margin-left:auto">${dataTsHtml(d.data_ts,d.stale)} <span class="data-ts">60s 自刷</span></span></div>
      <div style="overflow-x:auto"><table><thead><tr><th>${T('币种','Symbol')}</th><th>${T('价格','Price')}</th><th>24h</th><th>${T('24h高','High')}</th><th>${T('24h低','Low')}</th><th>${T('成交额','Volume')}</th></tr></thead><tbody>${spotRows||'<tr><td colspan="6" class="empty">—</td></tr>'}</tbody></table></div>
    </div>
    <div class="card">
      <div class="card-title">${T('合约市场 TOP50 · Coinglass','Futures TOP50 · Coinglass')}</div>
      <div style="overflow-x:auto"><table><thead><tr><th>#</th><th>${T('币种','Symbol')}</th><th>${T('价格','Price')}</th><th>24h</th><th>${T('费率','Funding')}</th><th>OI</th><th>OI 24h</th></tr></thead><tbody>${futRows||'<tr><td colspan="7" class="empty">—</td></tr>'}</tbody></table></div>
    </div>`;
  }
  await draw();
  startTabTimer('markets',draw);
};

/* ================= PANEL: 概念词典 ================= */

PANELS['market-analysis']=async function(){startTabTimer('market-analysis',PANELS['market-analysis']);
  const main=$('#main');
  main.innerHTML='<div class="card">加载中…</div>';
  try{
    const d=await fetch('/api/market-analysis').then(function(r){return r.json()});
    if(!d||!d.ok){main.innerHTML='<div class="card">数据不可用</div>';return}
    var b=d.data.btc, e=d.data.eth, s=d.data.sol, m=d.data.market, q=d.data.quadrants;
    var stateColor=q.state=='BTC 主导牛市'||q.state=='山寨季'?'#5f9e7a':q.state=='避险轮动'?'#d9a441':'#c06a5e';
    var btcDirIcon=q.btc_price_dir=='up'?'↑':'↓';
    var domDirIcon=q.btc_dom_dir=='up'?'↑':'↓';
    main.innerHTML='<div class="card"><div class="card-title">BTC.D + BTC 价格四象限定位</div><div style="margin-top:8px">'
      +'<div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;text-align:center">'
      +'<div style="background:#1c1e24;border-radius:6px;padding:10px"><div style="font-size:10px;color:#888">BTC 价格</div><div style="font-size:18px;font-weight:700;color:'+(q.btc_price_dir=='up'?'#5f9e7a':'#c06a5e')+'">'+btcDirIcon+' '+Number(b.chg_24h).toFixed(2)+'%</div></div>'
      +'<div style="background:#1c1e24;border-radius:6px;padding:10px"><div style="font-size:10px;color:#888">BTC.D</div><div style="font-size:18px;font-weight:700;color:'+(q.btc_dom_dir=='up'?'#5f9e7a':'#c06a5e')+'">'+domDirIcon+' '+b.dominance.toFixed(1)+'%</div></div>'
      +'</div>'
      +'<div style="background:'+stateColor+';color:#fff;border-radius:6px;padding:10px;margin-top:8px;text-align:center;font-weight:600;font-size:15px">'+q.state+'</div>'
      +'<div style="font-size:10px;color:#888;margin-top:4px;text-align:center">资金涌入但 BTC 吸走最大份额</div>'
      +'</div></div>'
      +'<div class="card"><div class="card-title">链上流动性指标</div><div style="display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-top:8px">'
      +'<div class="oi-i"><div class="oi-l">总加密市值</div><div class="oi-v">'+(m.total_mcap?'$'+(m.total_mcap/1e12).toFixed(2)+'T':'--')+'</div></div>'
      +'<div class="oi-i"><div class="oi-l">BTC 市值</div><div class="oi-v">'+(b.mcap?'$'+(b.mcap/1e12).toFixed(2)+'T':'--')+'</div></div>'
      +'<div class="oi-i"><div class="oi-l">Total3（山寨币）</div><div class="oi-v" style="color:#d9a441">'+(m.total3>0?'$'+(m.total3/1e9).toFixed(0)+'B':'--')+'</div></div>'
      +'<div class="oi-i"><div class="oi-l">稳定币预估</div><div class="oi-v" style="color:#8ab87a">'+'$'+(m.stablecoin_mcap_est/1e9).toFixed(0)+'B</div></div>'
      +'<div class="oi-i"><div class="oi-l">ETH/BTC</div><div class="oi-v">'+(m.eth_btc_ratio>0?m.eth_btc_ratio.toFixed(5):'--')+'</div></div>'
      +'<div class="oi-i"><div class="oi-l">SOL/BTC</div><div class="oi-v">'+(m.sol_btc_ratio>0?m.sol_btc_ratio.toFixed(6):'--')+'</div></div>'
      +'</div></div>'
      +'<div class="card"><div class="card-title">指标说明</div>'
      +'<div style="font-size:11px;color:#888;line-height:1.7">'
      +'四象限判断基于 BTC 价格 24h 变化方向与 BTC.D 当前水平。<br>'
      +'当 BTC.D 下降时，需同时观察 ETH/BTC 汇率与 Total3 确认资金是否真实流向山寨。<br>'
      +'稳定币占比衡量链上美元弹药。Total3 剔除 BTC/ETH/稳定币，反映真实山寨筹码市值。<br>'
      +'⚠ 部分数据为估算值（ETH 市值、稳定币市值），完整数据需要 CoinGecko/CoinMarketCap API Key。</div></div>'
  }catch(e){main.innerHTML='<div class="card">加载异常: '+esc(e.message)+'</div>';}
};
PANELS.glossary=async function(){
  const main=$('#main');
  const d=await api('/api/glossary');
  const terms=(d.terms||[]).map(t=>`<div class="term">
    <div class="term-en">${esc(t.en)}</div>
    <div class="term-zh">${esc(t.zh)}</div>
    <div class="term-desc">${esc(state.lang==='zh'?t.desc_zh:t.desc_en)}</div>
  </div>`).join('');
  main.innerHTML=`<div class="card">
    <div class="card-title">${T('概念词典 · 加密交易术语中英对照','Glossary · Crypto Trading Terms')} <span class="data-ts">${d.count||0} terms</span></div>
    <div class="glossary-grid">${terms}</div></div>`;
};

'use strict';
/* ================= PANEL: 多空LSR（会员） ================= */
function lsrTable(rows,mode){
  if(!rows||!rows.length)return'<div class="empty">暂无数据，等待采集</div>';
  const body=rows.map(c=>{
    const ratio=mode==='whale'?(c.whale_ratio??c.ratio):(c.trader_ratio??c.ratio);
    const d2m=mode==='whale'?(c.whale_delta_2m??c.delta_2m):c.delta_2m;
    const d4h=mode==='whale'?(c.whale_delta_4h??c.delta_4h):(c.trader_delta_4h??c.delta_4h);
    return `<tr><td class="num">${c.rank??''}</td><td>${esc(c.symbol)}</td>
      <td class="num ${cls((ratio||1)-1)}">${ratio!=null?Number(ratio).toFixed(2):'—'}</td>
      <td class="num ${cls(d2m)}">${d2m!=null?fmtPct(d2m*100):'—'}</td>
      <td class="num ${cls(d4h)}">${d4h!=null?fmtPct(d4h*100):'—'}</td>
      <td class="num">${c.oi_mcap_ratio!=null?(c.oi_mcap_ratio*100).toFixed(1)+'%':'—'}</td></tr>`;
  }).join('');
  return `<div style="overflow-x:auto"><table><thead><tr><th>#</th><th>${T('币种','Symbol')}</th><th>${T('多空比','L/S Ratio')}</th><th>Δ2m</th><th>Δ4h</th><th>OI/MCap</th></tr></thead><tbody>${body}</tbody></table></div>`;
}
PANELS.lsr=async function(){
  const main=$('#main');
  main.innerHTML='<div class="card">加载中…</div>';
  const d=await api('/api/member/lsr');
  if(d.__needLogin){state.user=null;switchTab('lsr');return}
  main.innerHTML=`<div class="card">
    <div class="card-title">${T('多空比双榜 TOP20','Long/Short Ratio Dual Rankings TOP20')}
      <span style="margin-left:auto">${dataTsHtml(d.data_ts,d.stale)}</span></div>
    <div class="grid2">
      <div><div class="verdict-label">${T('交易者模式','TRADER MODE')}</div>${lsrTable(d.trader,'trader')}</div>
      <div><div class="verdict-label">${T('大户模式','WHALE MODE')}</div>${lsrTable(d.whale,'whale')}</div>
    </div></div>`;
};

/* ================= PANEL: 费率套利（会员） ================= */
PANELS.funding=async function(){
  const main=$('#main');
  main.innerHTML='<div class="card">加载中…</div>';
  const d=await api('/api/member/funding-arb');
  if(d.__needLogin){state.user=null;switchTab('funding');return}
  const rows=(d.rows||[]).map(r=>`<tr>
    <td class="num">${r.rank??''}</td><td class="coin-sym" style="font-size:13px">${esc(r.symbol)}</td>
    <td class="num up">${r.apr!=null?Number(r.apr).toFixed(0)+'%':'—'}</td>
    <td>${esc(r.buy&&r.buy.exchange||'—')} <span class="num ${cls(-(r.buy&&r.buy.funding_rate||0))}">${r.buy?(r.buy.funding_rate*100).toFixed(3)+'%':''}</span></td>
    <td>${esc(r.sell&&r.sell.exchange||'—')} <span class="num ${cls(r.sell&&r.sell.funding_rate||0)}">${r.sell?(r.sell.funding_rate*100).toFixed(3)+'%':''}</span></td>
    <td class="num">${r.fee!=null?Number(r.fee).toFixed(2):'—'}</td>
    <td class="num">${r.next_funding_time?new Date(r.next_funding_time).toLocaleTimeString('zh-CN',{hour12:false,timeZone:'Asia/Shanghai'}):'—'}</td></tr>`).join('');
  main.innerHTML=`<div class="card">
    <div class="card-title">${T('资金费率套利榜 · 按 APR','Funding Rate Arbitrage · by APR')}
      <span style="margin-left:auto">${dataTsHtml(d.data_ts,d.stale)}</span></div>
    <div class="verdict-block" style="margin-bottom:10px">${T('买 = 低费率交易所做多，卖 = 高费率交易所做空，赚取费率差。APR 为年化参考，不构成收益承诺。','Buy low-funding exchange, sell high-funding one, harvest the spread.')}</div>
    <div style="overflow-x:auto"><table><thead><tr><th>#</th><th>${T('币种','Symbol')}</th><th>APR</th><th>${T('买(多)','Buy(Long)')}</th><th>${T('卖(空)','Sell(Short)')}</th><th>${T('费用','Fee')}</th><th>${T('下次结算','Next')}</th></tr></thead><tbody>${rows||'<tr><td colspan="7" class="empty">—</td></tr>'}</tbody></table></div>
  </div>`;
};

/* ================= PANEL: KOL共识（会员） ================= */
PANELS.consensus=async function(){
  const main=$('#main');
  main.innerHTML='<div class="card">加载中…</div>';
  const d=await api('/api/member/consensus');
  if(d.__needLogin){state.user=null;switchTab('consensus');return}
  const cards=(d.coins||[]).map(c=>{
    const bias=c.trust_adjusted_bias||0;
    return `<div class="coin-card">
      <div class="coin-head"><span class="coin-sym">${esc(c.symbol)}</span>
        <span class="badge ${c.decision==='long'?'bullish':c.decision==='short'?'bearish':'neutral'}">${esc(c.decision_label||c.decision||'—')}</span></div>
      <div class="coin-price num">${fmtPrice(c.price)}</div>
      <div class="conf-bar"><div class="conf-fill" style="width:${Math.round((c.confidence||0)*100)}%;background:${c.decision==='long'?'#5f9e7a':c.decision==='short'?'#c06a5e':'#d9a441'}"></div></div>
      <div class="data-ts">confidence ${Math.round((c.confidence||0)*100)}% · bias <span class="${cls(bias)}">${bias>=0?'+':''}${bias.toFixed(3)}</span></div>
      <div class="coin-headline" style="margin-top:8px">${(c.top_factors||[]).map(f=>`· ${esc(f.name||f.id)}（${f.score>=0?'+':''}${f.score}）`).join('<br>')||'—'}</div>
      <div class="coin-official">${T('快照','snapshot')} ${esc(c.snapshot_date||'—')} · ${c.snapshot_age_hours!=null?Number(c.snapshot_age_hours).toFixed(0)+'h ago':''}</div>
    </div>`;
  }).join('');
  main.innerHTML=`<div class="card">
    <div class="card-title">${T('KOL 共识信号','KOL Consensus Signals')}
      <span style="margin-left:auto">${dataTsHtml(d.data_ts,d.stale)}</span></div>
    <div class="coin-grid">${cards||'<div class="empty">暂无数据</div>'}</div></div>`;
};

/* ================= PANEL: AI日报（会员） ================= */
PANELS.aidaily=async function(){
  const main=$('#main');
  main.innerHTML='<div class="card">加载中…</div>';
  const d=await api('/api/member/ai-daily');
  if(d.__needLogin){state.user=null;switchTab('aidaily');return}
  const items=(d.days||[]).map(x=>`<div class="tl-item">
    <div><span class="tl-date">${esc(x.date)}</span><span class="tl-src">${esc(x.ai_source||'')}</span>
    ${x.posture?`<span class="badge ${x.posture.state}" style="margin-left:8px">${x.posture.state} ${x.posture.score}</span>`:''}
    ${x.verdict?`<span class="badge ${x.verdict.verdict}" style="margin-left:4px">${esc(x.verdict.verdict_zh||x.verdict.verdict)}</span>`:''}</div>
    <div class="tl-text">${esc(state.lang==='zh'?(x.ai_text||''):(x.ai_text_en||x.ai_text||''))}</div>
  </div>`).join('');
  main.innerHTML=`<div class="card">
    <div class="card-title">${T('AI 每日判断 · 近 30 天','AI Daily Verdict · Last 30 Days')}
      <span style="margin-left:auto">${dataTsHtml(d.data_ts,false)}</span></div>
    <div class="verdict-block" style="margin-bottom:14px">${T('每日 08:30（Asia/Shanghai）由 DeepSeek 双 key 生成；双 key 故障时自动降级为规则模板，来源标注在每条条目上。','Generated 08:30 Asia/Shanghai with dual-key DeepSeek failover; rule-template fallback is labeled.')}</div>
    <div class="timeline">${items||'<div class="empty">暂无日报</div>'}</div></div>`;
};

/* ================= PANEL: 倒计时（会员） ================= */
PANELS.countdown=async function(){
  const main=$('#main');
  main.innerHTML='<div class="card">加载中…</div>';
  const d=await api('/api/member/countdown');
  if(d.__needLogin){state.user=null;switchTab('countdown');return}
  const cd=d.countdown,p=d.posture;
  const moveZh={done:'已达成',closer:'接近中',none:'无进展'};
  const conds=(cd.conditions||[]).map(c=>{
    const pct=Math.round((c.progress||0)*100);
    const col=c.today_move==='done'?'#5f9e7a':c.today_move==='closer'?'#d9a441':'#6d6a62';
    return `<div class="cond-card">
      <div class="cond-head"><span class="cond-label">${esc(state.lang==='zh'?c.label_zh:c.label_en)}</span>
        <span class="cond-bucket" style="color:${col}">${esc(c.distance_bucket||'')} · ${esc(moveZh[c.today_move]||c.today_move)}</span></div>
      <div class="cond-line">${esc(state.lang==='zh'?c.line_zh:c.line_en)}</div>
      <div class="progress"><div class="progress-fill" style="width:${pct}%;${c.today_move==='done'?'background:#5f9e7a':''}"></div></div>
      <div class="data-ts">${pct}%</div>
    </div>`;
  }).join('');
  const off=(cd.official||[]).map(c=>`<tr><td>${esc(c.label_zh||c.key)}</td><td>${esc(c.line_zh||'')}</td><td class="num">${esc(c.distance_bucket||'')}</td><td class="num">${esc(c.today_move||'')}</td></tr>`).join('');
  main.innerHTML=`<div class="card">
    <div class="card-title">${T('翻转条件倒计时','Flip Condition Countdown')}
      <span style="margin-left:auto">${dataTsHtml(d.data_ts,d.stale)}</span></div>
    <div class="kv-strip">
      <span>${T('当前姿态','posture')} <b>${esc(p.state)} ${p.score>0?'+':''}${p.score}</b></span>
      <span>${T('已维持','held')} <b>${p.days_held}d</b></span>
      <span>${T('目标状态','target')} <b>${esc(cd.target_state)}</b></span>
      <span>${T('总体进度','overall')} <b>${Math.round((cd.overall_progress||0)*100)}%</b></span>
    </div>
    <div class="verdict-block" style="margin-bottom:14px">${esc(cd.note_zh||'')}</div>
    ${conds}
  </div>
  ${off?`<div class="card"><div class="card-title">${T('William countdown 对照','William Countdown')}</div>
    <div style="overflow-x:auto"><table><thead><tr><th>${T('条件','Cond')}</th><th>${T('描述','Line')}</th><th>${T('距离','Distance')}</th><th>${T('今日动向','Move')}</th></tr></thead><tbody>${off}</tbody></table></div></div>`:''}`;
};

'use strict';
/* ================= PANEL: 登录/注册/我的账户 ================= */
PANELS.account=async function(){
  const main=$('#main');
  if(state.user){
    main.innerHTML=`<div class="card form-box">
      <div class="card-title">${T('我的账户','My Account')}</div>
      <div class="kv-strip" style="flex-direction:column;gap:8px;align-items:flex-start">
        <span>${T('用户名','username')} <b>${esc(state.user.username)}</b></span>
        <span>${T('状态','status')} <span class="badge ${state.user.status}">${state.user.status==='approved'?T('已开通','approved'):state.user.status}</span></span>
        <span>${T('注册时间','registered')} <b>${state.user.created_at?new Date(state.user.created_at).toLocaleString('zh-CN',{hour12:false}):'—'}</b></span>
        <span>${T('开通时间','approved at')} <b>${state.user.approved_at?new Date(state.user.approved_at).toLocaleString('zh-CN',{hour12:false}):'—'}</b></span>
      </div>
      <div class="verdict-block" style="margin:12px 0">${T('会员栏目已解锁：多空LSR / 费率套利 / KOL共识 / AI日报 / 倒计时。会话 7 天有效，httpOnly cookie 存储。','Member tabs unlocked. Session valid 7 days via httpOnly cookie.')}</div>
      <button class="btn danger" id="logoutBtn">${T('退出登录','Sign out')}</button>
    </div>`;
    $('#logoutBtn').onclick=async()=>{await api('/api/auth/logout',{method:'POST',body:'{}'});state.user=null;refreshUserChip();toast(T('已退出','Signed out'));switchTab('account')};
    return;
  }
  main.innerHTML=`<div class="card form-box">
    <div class="card-title" id="authTitle">${T('登录','Sign In')}</div>
    <div id="loginForm">
      <div class="field"><label>${T('用户名','Username')}</label><input id="liUser" autocomplete="username"></div>
      <div class="field"><label>${T('密码','Password')}</label><input id="liPass" type="password" autocomplete="current-password"></div>
      <div class="form-msg" id="liMsg"></div>
      <button class="btn" style="width:100%" id="liBtn">${T('登录','Sign in')}</button>
      <div class="form-switch">${T('还没有账号？','No account?')} <a href="javascript:void 0" id="showReg">${T('注册（需管理员审批）','Register')}</a></div>
    </div>
    <div id="regForm" style="display:none">
      <div class="field"><label>${T('用户名（2-24位）','Username (2-24)')}</label><input id="rgUser" autocomplete="username"></div>
      <div class="field"><label>${T('密码（至少6位）','Password (6+)')}</label><input id="rgPass" type="password" autocomplete="new-password"></div>
      <div class="field"><label>${T('确认密码','Confirm')}</label><input id="rgPass2" type="password" autocomplete="new-password"></div>
      <div class="form-msg" id="rgMsg"></div>
      <button class="btn" style="width:100%" id="rgBtn">${T('提交注册','Register')}</button>
      <div class="form-switch">${T('已有账号？','Have an account?')} <a href="javascript:void 0" id="showLogin">${T('直接登录','Sign in')}</a></div>
    </div>
  </div>`;
  const liMsg=$('#liMsg'),rgMsg=$('#rgMsg');
  $('#showReg').onclick=()=>{$('#loginForm').style.display='none';$('#regForm').style.display='block';$('#authTitle').textContent=T('注册 · 审批制','Register · Approval-gated')};
  $('#showLogin').onclick=()=>{$('#regForm').style.display='none';$('#loginForm').style.display='block';$('#authTitle').textContent=T('登录','Sign In')};
  $('#liBtn').onclick=async()=>{
    liMsg.className='form-msg';liMsg.textContent='…';
    const r=await api('/api/auth/login',{method:'POST',body:JSON.stringify({username:$('#liUser').value,password:$('#liPass').value})});
    if(r.ok){state.user=r.user;refreshUserChip();toast(T('登录成功','Welcome'));switchTab('overview')}
    else{liMsg.className='form-msg err';liMsg.textContent=r.message||r.error||T('登录失败','failed')}
  };
  $('#rgBtn').onclick=async()=>{
    rgMsg.className='form-msg';
    if($('#rgPass').value!==$('#rgPass2').value){rgMsg.className='form-msg err';rgMsg.textContent=T('两次密码不一致','passwords differ');return}
    rgMsg.textContent='…';
    const r=await api('/api/auth/register',{method:'POST',body:JSON.stringify({username:$('#rgUser').value,password:$('#rgPass').value})});
    if(r.ok){rgMsg.className='form-msg ok';rgMsg.textContent=T('✓ 注册成功，账号为待审批状态，管理员批准后即可登录。','✓ Registered. Pending admin approval.')}
    else{rgMsg.className='form-msg err';rgMsg.textContent=r.message||r.error||T('注册失败','failed')}
  };
};
function refreshUserChip(){
  const chip=$('#userChip');
  if(state.user){chip.style.display='';chip.textContent='◆ '+state.user.username}
  else chip.style.display='none';
}

/* ================= PANEL: 后台 ================= */
PANELS.admin=async function(){
  const main=$('#main');
  if(!state.admin){
    main.innerHTML=`<div class="card form-box">
      <div class="card-title">${T('管理员后台','Admin Console')}</div>
      <div class="field"><label>${T('管理密码','Admin password')}</label><input id="adPass" type="password"></div>
      <div class="form-msg" id="adMsg"></div>
      <button class="btn" style="width:100%" id="adBtn">${T('进入后台','Enter')}</button>
      <div class="verdict-block" style="margin-top:12px;font-size:12px">${T('后台会话与会员会话相互独立（不同 cookie），互不影响。','Admin session is independent from member session.')}</div>
    </div>`;
    $('#adBtn').onclick=async()=>{
      const r=await api('/api/admin/login',{method:'POST',body:JSON.stringify({password:$('#adPass').value})});
      if(r.ok){state.admin=true;PANELS.admin()}else{$('#adMsg').className='form-msg err';$('#adMsg').textContent=T('密码错误','wrong password')}
    };
    $('#adPass').onkeydown=e=>{if(e.key==='Enter')$('#adBtn').click()};
    return;
  }
  main.innerHTML='<div class="card">加载后台数据…</div>';
  const [users,health,sys]=await Promise.all([api('/api/admin/users'),api('/api/admin/health'),api('/api/admin/system-stats')]);
  if(users.__needAdmin){state.admin=false;PANELS.admin();return}
  const statusZh={pending:'待审批',approved:'已开通',rejected:'已拒绝'};
  const urows=(users.users||[]).map(u=>`<tr class="${u.status==='pending'?'pending-row':''}">
    <td class="num">${u.id}</td><td>${esc(u.username)}</td>
    <td><span class="badge ${u.status}">${statusZh[u.status]||u.status}</span></td>
    <td class="num">${new Date(u.created_at).toLocaleString('zh-CN',{hour12:false})}</td>
    <td class="num">${u.approved_at?new Date(u.approved_at).toLocaleString('zh-CN',{hour12:false}):'—'}</td>
    <td style="white-space:nowrap">
      ${u.status!=='approved'?`<button class="btn small" data-act="approve" data-id="${u.id}">${T('批准','Approve')}</button>`:''}
      ${u.status!=='rejected'?`<button class="btn small secondary" data-act="reject" data-id="${u.id}">${T('拒绝','Reject')}</button>`:''}
      <button class="btn small danger" data-act="delete" data-id="${u.id}">${T('删除','Delete')}</button>
    </td></tr>`).join('');
  const hrows=(health.latest_by_source||[]).map(h=>`<div class="health-row">
    <span><span class="dot ${h.ok?'g':'r'}"></span>${esc(h.source)}</span>
    <span class="data-ts">${h.ms}ms · ${fmtTs(h.ts)}${h.detail?' · '+esc(String(h.detail).slice(0,60)):''}</span></div>`).join('');
  const jobs=['gate-prices','futures-markets','lsr-trader','lsr-whale','funding-arb','consensus','fear-greed','openclue','daily-verdict'];
  main.innerHTML=`
  <div class="card">
    <div class="card-title">${T('用户审批','User Approval')}
      <span class="badge pending" style="margin-left:6px">${(users.users||[]).filter(u=>u.status==='pending').length} ${T('待审批','pending')}</span>
      <span style="margin-left:auto"><button class="btn small secondary" id="adLogout">${T('退出后台','Exit admin')}</button></span></div>
    <div style="overflow-x:auto"><table><thead><tr><th>ID</th><th>${T('用户名','User')}</th><th>${T('状态','Status')}</th><th>${T('注册时间','Registered')}</th><th>${T('开通时间','Approved')}</th><th>${T('操作','Actions')}</th></tr></thead><tbody>${urows||'<tr><td colspan="6" class="empty">暂无用户</td></tr>'}</tbody></table></div>
  </div>
  <div class="admin-grid">
    <div class="card">
      <div class="card-title">${T('数据源健康','Source Health')}</div>
      ${hrows||'<div class="empty">—</div>'}
    </div>
    <div class="card">
      <div class="card-title">${T('系统状态','System')}</div>
      <div class="kv-strip" style="flex-direction:column;gap:6px;align-items:flex-start">
        <span>uptime <b>${health.uptime_sec}s</b> · RSS <b>${health.memory_mb}MB</b> · DB <b>${(health.db_bytes/1048576).toFixed(1)}MB</b></span>
        <span>CG key <b>${esc(health.cg_key.masked)}</b> ${health.cg_key.cooling?'<span class="badge bearish">冷却中</span>':'<span class="badge approved">正常</span>'}</span>
        <span>AI keys <b>A:${health.ai_keys.a?'✓':'✗'} B:${health.ai_keys.b?'✓':'✗'}</b> model <b>${esc(health.ai_keys.model)}</b></span>
        <span>QQ <b>${esc(health.qq.appid)}</b> group_openid <b>${health.qq.group_openid_set?'已配置':'未配置(推送静默跳过)'}</b></span>
        <span>tables <b>${Object.entries(health.table_counts||{}).map(([k,v])=>k+':'+v).join(' · ')}</b></span>
      </div>
    </div>
  </div>
  <div class="card">
    <div class="card-title">${T('系统监控','System Monitor')}</div>
    <div class="mon-bar">🖥 ${esc(sys.host)} · ${esc(sys.os)} · ${T('运行','up')} ${fmtDur(sys.uptime_sec)}</div>
    <div class="mon-bar">⚙️ ${T('CPU负载','CPU Load')}
      <div class="bar-track"><div class="bar-fill ${barClass(sys.cpu.load_1m/sys.cpu.cores*100)}" style="width:${Math.min(sys.cpu.load_1m/sys.cpu.cores*100,100)}%"></div></div>
      <span class="bar-label">${sys.cpu.load_1m.toFixed(2)} / ${sys.cpu.load_5m.toFixed(2)} / ${sys.cpu.load_15m.toFixed(2)}</span>
    </div>
    <div class="mon-bar">💾 ${T('内存','RAM')}
      <div class="bar-track"><div class="bar-fill ${barClass(sys.memory.used_pct)}" style="width:${sys.memory.used_pct}%"></div></div>
      <span class="bar-label">${(sys.memory.used_bytes/1073741824).toFixed(1)}G / ${(sys.memory.total_bytes/1073741824).toFixed(1)}G (${sys.memory.used_pct}%)</span>
    </div>
    <div class="mon-bar">📀 ${T('磁盘','Disk')}
      <div class="bar-track"><div class="bar-fill ${barClass(sys.disk.used_pct)}" style="width:${sys.disk.used_pct}%"></div></div>
      <span class="bar-label">${(sys.disk.used_bytes/1073741824).toFixed(1)}G / ${(sys.disk.total_bytes/1073741824).toFixed(1)}G (${sys.disk.used_pct}%)</span>
    </div>
    <div class="card-title" style="margin-top:12px;font-size:13px">${T('进程','Processes')}</div>
    <div class="proc-grid">
      ${(sys.pm2||[]).map(p => {
        const cpuPct = Math.min(p.cpu,100);
        const memMb = (p.mem_bytes/1048576).toFixed(0);
        return `<div class="proc-card">
          <div class="proc-name"><span class="dot ${p.status==='running'?'g':'r'}"></span>${esc(p.name)}</div>
          <div class="proc-stat">
            <span>PID <b>${p.pid}</b></span>
            <span>CPU <div class="bar-track" style="display:inline-flex;width:50px;height:6px;vertical-align:middle"><div class="bar-fill ${barClass(cpuPct)}" style="width:${cpuPct}%"></div></div> <b>${p.cpu}%</b></span>
            <span>MEM <b>${memMb}MB</b></span>
            <span>⏱ ${fmtDur(Math.floor(p.uptime_ms/1000))}</span>
          </div>
        </div>`;
      }).join('')}
    </div>
    ${sys.top_cpu&&sys.top_cpu.length ?
      `<div class="card-title" style="margin-top:12px;font-size:13px">${T('活跃进程 Top5','Top 5 by CPU')}</div>
      <div class="proc-grid">
        ${sys.top_cpu.map(t =>
          `<div class="proc-card">
            <div class="proc-name" style="font-size:11px;color:var(--text2)">${esc(t.user)}</div>
            <div class="proc-stat">
              <span>CPU <div class="bar-track" style="display:inline-flex;width:50px;height:6px;vertical-align:middle"><div class="bar-fill ${barClass(parseFloat(t.cpu_pct))}" style="width:${Math.min(parseFloat(t.cpu_pct),100)}%"></div></div> <b>${t.cpu_pct}%</b></span>
              <span>MEM <b>${t.mem_pct}%</b></span>
              <span style="flex:1;overflow:hidden;text-overflow:ellipsis">${esc(t.cmd)}</span>
            </div>
          </div>`
        ).join('')}
      </div>`
    : ''}
  </div>
<div style="grid-column:1/-1">
  <div class="card">
    <div class="card-title" style="margin-top:14px">${T('手动触发采集','Manual Trigger')}</div>
      <div class="trigger-grid">${jobs.map(j=>`<button class="btn small secondary" data-job="${j}">${j}</button>`).join('')}</div>
      <div class="form-msg" id="trigMsg"></div>
    </div>
  </div>`;
  $('#adLogout').onclick=async()=>{await api('/api/admin/logout',{method:'POST',body:'{}'});state.admin=false;PANELS.admin()};
  $$('[data-act]').forEach(b=>b.onclick=async()=>{
    const r=await api(`/api/admin/users/${b.dataset.id}/${b.dataset.act}`,{method:'POST',body:'{}'});
    if(r.ok){toast(T('操作成功','done'));PANELS.admin()}else toast(r.error||'failed');
  });
  $$('[data-job]').forEach(b=>b.onclick=async()=>{
    $('#trigMsg').className='form-msg';$('#trigMsg').textContent=b.dataset.job+' …';
    const r=await api(`/api/admin/trigger/${b.dataset.job}`,{method:'POST',body:'{}'});
    $('#trigMsg').className='form-msg '+(r.ok&&r.success?'ok':'err');
    $('#trigMsg').textContent=`${b.dataset.job}: ${r.success?'OK':'FAIL'} (${r.ms}ms)`;
  });
};

/* ================= 启动 ================= */
async function boot(){
  renderNav();
  // 时钟
  const tick=()=>{$('#clock').textContent=new Date().toLocaleTimeString('zh-CN',{hour12:false,timeZone:'Asia/Shanghai'})+' CST'};
  tick();setInterval(tick,1000);
  // 指纹
  const v=await api('/api/version');
  if(v.ok)$('#fp').textContent=`${v.name}@${v.version} sha:${v.dashboard_html.sha256_16} ${v.dashboard_html.bytes}B full:${v.dashboard_html.is_full_terminal}`;
  // 会话恢复（会员与后台互不影响）
  const me=await api('/api/auth/me');
  if(me.ok&&me.user&&me.user.status==='approved'){state.user=me.user}
  refreshUserChip();
  const ah=await api('/api/admin/users?status=pending');
  if(!ah.__needAdmin&&ah.ok)state.admin=true;
  // 语言切换
  $('#langBtn').onclick=()=>{state.lang=state.lang==='zh'?'en':'zh';$('#langBtn').textContent=state.lang==='zh'?'EN':'中';renderNav();switchTab(state.tab)};
  $('#langBtn').textContent='EN';
  switchTab('overview');
}
boot();
','lsr-whale','funding-arb','consensus','fear-greed','openclue','daily-verdict'];
  main.innerHTML=`
  <div class="card">
    <div class="card-title">${T('用户审批','User Approval')}
      <span class="badge pending" style="margin-left:6px">${(users.users||[]).filter(u=>u.status==='pending').length} ${T('待审批','pending')}</span>
      <span style="margin-left:auto"><button class="btn small secondary" id="adLogout">${T('退出后台','Exit admin')}</button></span></div>
    <div style="overflow-x:auto"><table><thead><tr><th>ID</th><th>${T('用户名','User')}</th><th>${T('状态','Status')}</th><th>${T('注册时间','Registered')}</th><th>${T('开通时间','Approved')}</th><th>${T('操作','Actions')}</th></tr></thead><tbody>${urows||'<tr><td colspan="6" class="empty">暂无用户</td></tr>'}</tbody></table></div>
  </div>
  <div class="admin-grid">
    <div class="card">
      <div class="card-title">${T('数据源健康','Source Health')}</div>
      ${hrows||'<div class="empty">—</div>'}
    </div>
    <div class="card">
      <div class="card-title">${T('系统状态','System')}</div>
      <div class="kv-strip" style="flex-direction:column;gap:6px;align-items:flex-start">
        <span>uptime <b>${health.uptime_sec}s</b> · RSS <b>${health.memory_mb}MB</b> · DB <b>${(health.db_bytes/1048576).toFixed(1)}MB</b></span>
        <span>CG key <b>${esc(health.cg_key.masked)}</b> ${health.cg_key.cooling?'<span class="badge bearish">冷却中</span>':'<span class="badge approved">正常</span>'}</span>
        <span>AI keys <b>A:${health.ai_keys.a?'✓':'✗'} B:${health.ai_keys.b?'✓':'✗'}</b> model <b>${esc(health.ai_keys.model)}</b></span>
        <span>QQ <b>${esc(health.qq.appid)}</b> group_openid <b>${health.qq.group_openid_set?'已配置':'未配置(推送静默跳过)'}</b></span>
        <span>tables <b>${Object.entries(health.table_counts||{}).map(([k,v])=>k+':'+v).join(' · ')}</b></span>
      </div>
    </div>
  </div>
  <div class="card">
    <div class="card-title">${T('系统监控','System Monitor')}</div>
    <div class="mon-bar">🖥 ${esc(sys.host)} · ${esc(sys.os)} · ${T('运行','up')} ${fmtDur(sys.uptime_sec)}</div>
    <div class="mon-bar">⚙️ ${T('CPU负载','CPU Load')}
      <div class="bar-track"><div class="bar-fill ${barClass(sys.cpu.load_1m/sys.cpu.cores*100)}" style="width:${Math.min(sys.cpu.load_1m/sys.cpu.cores*100,100)}%"></div></div>
      <span class="bar-label">${sys.cpu.load_1m.toFixed(2)} / ${sys.cpu.load_5m.toFixed(2)} / ${sys.cpu.load_15m.toFixed(2)}</span>
    </div>
    <div class="mon-bar">💾 ${T('内存','RAM')}
      <div class="bar-track"><div class="bar-fill ${barClass(sys.memory.used_pct)}" style="width:${sys.memory.used_pct}%"></div></div>
      <span class="bar-label">${(sys.memory.used_bytes/1073741824).toFixed(1)}G / ${(sys.memory.total_bytes/1073741824).toFixed(1)}G (${sys.memory.used_pct}%)</span>
    </div>
    <div class="mon-bar">📀 ${T('磁盘','Disk')}
      <div class="bar-track"><div class="bar-fill ${barClass(sys.disk.used_pct)}" style="width:${sys.disk.used_pct}%"></div></div>
      <span class="bar-label">${(sys.disk.used_bytes/1073741824).toFixed(1)}G / ${(sys.disk.total_bytes/1073741824).toFixed(1)}G (${sys.disk.used_pct}%)</span>
    </div>
    <div class="card-title" style="margin-top:12px;font-size:13px">${T('进程','Processes')}</div>
    <div class="proc-grid">
      ${(sys.pm2||[]).map(p => {
        const cpuPct = Math.min(p.cpu,100);
        const memMb = (p.mem_bytes/1048576).toFixed(0);
        return `<div class="proc-card">
          <div class="proc-name"><span class="dot ${p.status==='running'?'g':'r'}"></span>${esc(p.name)}</div>
          <div class="proc-stat">
            <span>PID <b>${p.pid}</b></span>
            <span>CPU <div class="bar-track" style="display:inline-flex;width:50px;height:6px;vertical-align:middle"><div class="bar-fill ${barClass(cpuPct)}" style="width:${cpuPct}%"></div></div> <b>${p.cpu}%</b></span>
            <span>MEM <b>${memMb}MB</b></span>
            <span>⏱ ${fmtDur(Math.floor(p.uptime_ms/1000))}</span>
          </div>
        </div>`;
      }).join('')}
    </div>
    ${sys.top_cpu&&sys.top_cpu.length ?
      `<div class="card-title" style="margin-top:12px;font-size:13px">${T('活跃进程 Top5','Top 5 by CPU')}</div>
      <div class="proc-grid">
        ${sys.top_cpu.map(t =>
          `<div class="proc-card">
            <div class="proc-name" style="font-size:11px;color:var(--text2)">${esc(t.user)}</div>
            <div class="proc-stat">
              <span>CPU <div class="bar-track" style="display:inline-flex;width:50px;height:6px;vertical-align:middle"><div class="bar-fill ${barClass(parseFloat(t.cpu_pct))}" style="width:${Math.min(parseFloat(t.cpu_pct),100)}%"></div></div> <b>${t.cpu_pct}%</b></span>
              <span>MEM <b>${t.mem_pct}%</b></span>
              <span style="flex:1;overflow:hidden;text-overflow:ellipsis">${esc(t.cmd)}</span>
            </div>
          </div>`
        ).join('')}
      </div>`
    : ''}
  </div>
<div style="grid-column:1/-1">
  <div class="card">
    <div class="card-title" style="margin-top:14px">${T('手动触发采集','Manual Trigger')}</div>
      <div class="trigger-grid">${jobs.map(j=>`<button class="btn small secondary" data-job="${j}">${j}</button>`).join('')}</div>
      <div class="form-msg" id="trigMsg"></div>
    </div>
  </div>`;
  $('#adLogout').onclick=async()=>{await api('/api/admin/logout',{method:'POST',body:'{}'});state.admin=false;PANELS.admin()};
  $$('[data-act]').forEach(b=>b.onclick=async()=>{
    const r=await api(`/api/admin/users/${b.dataset.id}/${b.dataset.act}`,{method:'POST',body:'{}'});
    if(r.ok){toast(T('操作成功','done'));PANELS.admin()}else toast(r.error||'failed');
  });
  $$('[data-job]').forEach(b=>b.onclick=async()=>{
    $('#trigMsg').className='form-msg';$('#trigMsg').textContent=b.dataset.job+' …';
    const r=await api(`/api/admin/trigger/${b.dataset.job}`,{method:'POST',body:'{}'});
    $('#trigMsg').className='form-msg '+(r.ok&&r.success?'ok':'err');
    $('#trigMsg').textContent=`${b.dataset.job}: ${r.success?'OK':'FAIL'} (${r.ms}ms)`;
  });
};

/* ================= 启动 ================= */
async function boot(){
  renderNav();
  // 时钟
  const tick=()=>{$('#clock').textContent=new Date().toLocaleTimeString('zh-CN',{hour12:false,timeZone:'Asia/Shanghai'})+' CST'};
  tick();setInterval(tick,1000);
  // 指纹
  const v=await api('/api/version');
  if(v.ok)$('#fp').textContent=`${v.name}@${v.version} sha:${v.dashboard_html.sha256_16} ${v.dashboard_html.bytes}B full:${v.dashboard_html.is_full_terminal}`;
  // 会话恢复（会员与后台互不影响）
  const me=await api('/api/auth/me');
  if(me.ok&&me.user&&me.user.status==='approved'){state.user=me.user}
  refreshUserChip();
  const ah=await api('/api/admin/users?status=pending');
  if(!ah.__needAdmin&&ah.ok)state.admin=true;
  // 语言切换
  $('#langBtn').onclick=()=>{state.lang=state.lang==='zh'?'en':'zh';$('#langBtn').textContent=state.lang==='zh'?'EN':'中';renderNav();switchTab(state.tab)};
  $('#langBtn').textContent='EN';
  switchTab('overview');
}
boot();
</script>
